@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста — ИС аналитического мониторинга и прогнозирования динамики населения РФ (DemoScope)

' === Пользовательские роли (персоны) ===
Person(analyst, "Демограф-аналитик", "Мониторит демографические показатели, сравнивает территории, строит прогнозы")
Person(official, "Сотрудник органа гос. управления", "Анализирует радар проблем, использует отчёты для решений в соц.-дем. политике")
Person(researcher, "Исследователь / студент", "Изучает демографическую динамику, выгружает справки и отчёты")

' === Проектируемая система (чёрный ящик) ===
System(demoscope, "DemoScope", "ИС аналитического мониторинга и прогнозирования динамики населения РФ")

' === Внешние системы ===
System_Ext(rosstat, "Росстат", "Источник официальной демографической статистики")
System_Ext(emiss, "ЕМИСС", "Государственная платформа статистических данных")
System_Ext(gemini_api, "Google Gemini API", "LLM-сервис генерации аналитических заключений (Gemini 2.5 Flash)")
System_Ext(gdrive, "Google Drive", "Хранилище исходных массивов данных (CSV)")

' === Связи (строго направленные, с описанием данных и протоколом) ===
Rel(analyst, demoscope, "Мониторинг показателей, сравнение территорий, построение прогнозов", "HTTPS")
Rel(official, demoscope, "Запросы радара проблем и аналитических отчётов", "HTTPS")
Rel(researcher, demoscope, "Изучение динамики, выгрузка справок и отчётов", "HTTPS")
Rel(demoscope, rosstat, "Получение официальных демографических показателей", "HTTPS/REST")
Rel(demoscope, emiss, "Получение статистических данных по регионам", "HTTPS/REST")
Rel(demoscope, gemini_api, "Запрос на генерацию текста аналитического заключения", "HTTPS/JSON")
Rel(demoscope, gdrive, "Автозагрузка исходных массивов данных (CSV)", "HTTPS")
@enduml
