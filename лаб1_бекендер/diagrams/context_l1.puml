@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title Системный контекст DemoScope (Level 1) — мониторинг и прогнозирование динамики населения РФ

' === Пользовательские роли ===
Person(analyst, "Демограф-аналитик", "Наблюдает демографические показатели, сравнивает субъекты, строит прогнозы")
Person(official, "Сотрудник органа гос. управления", "Опирается на радар проблем и отчёты при решениях в демографической политике")
Person(researcher, "Исследователь / студент", "Изучает динамику населения, скачивает справки и отчёты")

' === Проектируемая система (чёрный ящик) ===
System(demoscope, "DemoScope", "ИС аналитического мониторинга и прогнозирования динамики населения РФ")

' === Внешние системы ===
System_Ext(rosstat, "Росстат", "Первичный источник демографической статистики")
System_Ext(emiss, "ЕМИСС", "Государственный узел публикации статистики")
System_Ext(gemini_api, "Google Gemini API", "Сторонний LLM-сервис (Gemini 2.5 Flash) для аналитических текстов")
System_Ext(gdrive, "Google Drive", "Внешнее хранилище исходных CSV-массивов")

' === Направленные связи с описанием данных и протоколом ===
Rel(analyst, demoscope, "Запросы мониторинга, сравнения территорий и построения прогнозов", "HTTPS")
Rel(official, demoscope, "Запросы радара проблем и отчётных материалов", "HTTPS")
Rel(researcher, demoscope, "Просмотр динамики, выгрузка справок и отчётов", "HTTPS")
Rel(demoscope, rosstat, "Получение официальной демографической статистики", "HTTPS/REST")
Rel(demoscope, emiss, "Запросы региональной статистики", "HTTPS/REST")
Rel(demoscope, gemini_api, "Генерация текста заключения через LLM", "HTTPS/JSON")
Rel(demoscope, gdrive, "Загрузка исходных наборов CSV", "HTTPS")
@enduml
