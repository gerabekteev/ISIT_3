@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title Диаграмма системного ландшафта (Level 0) — интеграция DemoScope в ведомственную ИТ-инфраструктуру

' === Пользовательские роли ===
Person(analyst, "Демограф-аналитик", "Мониторит показатели, строит прогнозы и сравнивает территории")
Person(official, "Сотрудник органа гос. управления", "Использует радар проблем и аналитические отчёты")
Person(researcher, "Исследователь / студент", "Изучает демографическую динамику, выгружает справки")

' === Целевая система и смежные системы внутри корпоративного контура ===
Enterprise_Boundary(region_infra, "Ведомственная ИТ-инфраструктура (закрытый контур)") {
  System(demoscope, "DemoScope", "ИС аналитического мониторинга и прогнозирования динамики населения РФ")

  System(esia, "ЕСИА (IAM)", "Единая система идентификации и аутентификации: учётные записи, SSO")
  System(crm, "Система обращений граждан (CRM)", "Ведомственная CRM: регистрация обращений, поручения, контроль сроков")
}

' === Внешние системы за пределами корпоративного контура ===
System_Ext(rosstat, "Росстат", "Официальная демографическая статистика")
System_Ext(emiss, "ЕМИСС", "Государственная платформа статистических данных")
System_Ext(gemini_api, "Google Gemini API", "LLM-сервис аналитических заключений")
System_Ext(billing, "Биллинг облачного провайдера", "Финансовая система: учёт потребления и стоимости облачных ресурсов")

' === Взаимодействие пользователей ===
Rel(analyst, demoscope, "Мониторинг показателей и построение прогнозов", "HTTPS")
Rel(official, demoscope, "Аналитические отчёты и радар проблем", "HTTPS")
Rel(researcher, demoscope, "Изучение демографической динамики", "HTTPS")

' === Интеграции внутри закрытого контура (защищённые межсистемные каналы) ===
Rel(demoscope, esia, "Сквозная аутентификация пользователей (OAuth2-поток)", "HTTPS / OAuth 2.0")
Rel(crm, demoscope, "Запрос аналитических справок для ответов на обращения", "gRPC / HTTP2")

' === Данные официальной статистики (внешние источники) ===
Rel(demoscope, rosstat, "Загрузка демографических показателей", "HTTPS/REST")
Rel(demoscope, emiss, "Загрузка статистических данных по регионам", "HTTPS/REST")

' === Внешний LLM-сервис ===
Rel(demoscope, gemini_api, "Генерация текста аналитических заключений", "HTTPS/JSON")

' === Финансовая интеграция ===
Rel(demoscope, billing, "Получение счетов и оплата потреблённых ресурсов", "HTTPS/REST")
@enduml
