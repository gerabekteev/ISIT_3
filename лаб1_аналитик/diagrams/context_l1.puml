@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title Контекстная диаграмма — ИС аналитического мониторинга и прогнозирования динамики населения РФ (DemoScope)

' === Пользовательские роли ===
Person(analyst, "Демограф-аналитик", "Отслеживает демографическую статистику, сопоставляет территории, запрашивает прогнозы")
Person(official, "Сотрудник органа гос. управления", "Применяет радар проблем и отчётные материалы при подготовке управленческих решений")
Person(researcher, "Исследователь / студент", "Анализирует демографические процессы, забирает справки и готовые отчёты")

' === Проектируемая система (чёрный ящик) ===
System(demoscope, "DemoScope", "ИС аналитического мониторинга и прогнозирования динамики населения РФ")

' === Внешние системы ===
System_Ext(rosstat, "Росстат", "Источник официальной статистики по населению")
System_Ext(emiss, "ЕМИСС", "Государственный портал статистической информации")
System_Ext(gemini_api, "Google Gemini API", "Облачный LLM (Gemini 2.5 Flash), готовящий тексты аналитических заключений")
System_Ext(gdrive, "Google Drive", "Облачная папка с исходными наборами данных (CSV)")

' === Направленные связи с описанием данных и протоколом ===
Rel(analyst, demoscope, "Просмотр показателей, сопоставление территорий, расчёт прогнозов", "HTTPS")
Rel(official, demoscope, "Работа с радаром проблем, получение аналитических отчётов", "HTTPS")
Rel(researcher, demoscope, "Просмотр динамики, скачивание справок и отчётов", "HTTPS")
Rel(demoscope, rosstat, "Сбор официальных демографических показателей", "HTTPS/REST")
Rel(demoscope, emiss, "Импорт региональной статистики", "HTTPS/REST")
Rel(demoscope, gemini_api, "Подготовка текста аналитического заключения средствами LLM", "HTTPS/JSON")
Rel(demoscope, gdrive, "Получение исходных наборов данных (CSV)", "HTTPS")
@enduml
