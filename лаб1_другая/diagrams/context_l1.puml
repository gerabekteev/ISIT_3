@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title Системный контекст — ИС аналитического мониторинга и прогнозирования динамики населения РФ (DemoScope)

' === Пользовательские роли ===
Person(analyst, "Демограф-аналитик", "Анализирует демографические показатели, сравнивает регионы, получает прогнозы")
Person(official, "Сотрудник органа гос. управления", "Работает с радаром проблем и отчётами при выработке социально-демографической политики")
Person(researcher, "Исследователь / студент", "Исследует демографическую динамику, выгружает справки и отчёты")

' === Проектируемая система (чёрный ящик) ===
System(demoscope, "DemoScope", "ИС аналитического мониторинга и прогнозирования динамики населения РФ")

' === Внешние системы ===
System_Ext(rosstat, "Росстат", "Официальная демографическая статистика")
System_Ext(emiss, "ЕМИСС", "Государственная платформа статистических данных")
System_Ext(gemini_api, "Google Gemini API", "Внешний LLM-сервис (Gemini 2.5 Flash) для текстов аналитических заключений")
System_Ext(gdrive, "Google Drive", "Исходные массивы данных в формате CSV")

' === Направленные связи с описанием данных и протоколом ===
Rel(analyst, demoscope, "Запросы показателей, сравнения регионов и расчёта прогнозов", "HTTPS")
Rel(official, demoscope, "Обращения к радару проблем и аналитическим отчётам", "HTTPS")
Rel(researcher, demoscope, "Запросы справок, выгрузка отчётов", "HTTPS")
Rel(demoscope, rosstat, "Загрузка официальных демографических показателей", "HTTPS/REST")
Rel(demoscope, emiss, "Получение статистики по субъектам РФ", "HTTPS/REST")
Rel(demoscope, gemini_api, "Формирование текста аналитического заключения (LLM)", "HTTPS/JSON")
Rel(demoscope, gdrive, "Скачивание исходных CSV-массивов данных", "HTTPS")
@enduml
